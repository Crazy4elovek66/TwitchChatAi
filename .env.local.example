# ===== РЕЖИМ =====
MODE=local
LEARNING_MODE=1
LEARNING_CHANNEL=your_channel

# ===== TWITCH =====
# Нужен и в local-режиме, чтобы получать HLS и метаданные стрима.
TWITCH_CHANNEL=your_channel
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_WEB_CLIENT_ID=kimne78kx3ncx6brgo4mv6wki5h1ko

# ===== БОТЫ =====
# В режиме обучения используется минимум BOT1.
BOT1_USERNAME=your_bot_username
BOT1_OAUTH=oauth:your_oauth_token

# ===== ЛОКАЛЬНЫЕ МОДЕЛИ =====
LOCAL_MODELS_PATH=models
VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22
VOSK_SAMPLE_RATE=16000
# Если Python не в .venv, укажите путь:
# VOSK_PYTHON=C:\Path\to\python.exe

# ===== LOCAL NLP =====
LOCAL_NLP_MODEL=Xenova/LaMini-Flan-T5-783M

# ===== AUDIO / VAD =====
AI_RMS_MIN=0.003

# ===== ОПЦИОНАЛЬНО: OCR / VISION =====
OCR_ENABLED=0
OCR_INTERVAL_MS=30000
VISION_ANALYSIS_INTERVAL_MS=45000
